<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HORIZON</AssemblyName>
    <RootNamespace>Horizon</RootNamespace>
    <Version>1.3.0-rc.3</Version>
    <AssemblyVersion>1.3.0.3</AssemblyVersion>
    <FileVersion>1.3.0.3</FileVersion>
    <Authors>Chazut</Authors>
    <Product>HORIZON</Product>
    <Description>Watch bots after death or extraction in solo SPT or with Fika's spectator camera.</Description>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SptRoot Condition="'$(SptRoot)' == ''">C:\Games\SPT-4.1</SptRoot>
  </PropertyGroup>
  <ItemGroup><Compile Include="src/**/*.cs" /></ItemGroup>
  <!-- The transport consumes HORIZON's internal API. Compile it against a private
       reference build, then embed it in the player-facing assembly. -->
  <PropertyGroup>
    <FikaTransport>$(MSBuildProjectDirectory)/fika/bin/$(Configuration)/$(TargetFramework)/HORIZON.Fika.Integration.dll</FikaTransport>
    <FikaReferenceDir>$(MSBuildProjectDirectory)/obj/fika-reference/$(Configuration)/</FikaReferenceDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildingFikaReference)' != 'true'">
    <EmbeddedResource Include="$(FikaTransport)" LogicalName="HORIZON.Fika.Integration.dll" />
  </ItemGroup>
  <Target Name="BuildEmbeddedFika" BeforeTargets="PrepareForBuild" Condition="'$(BuildingFikaReference)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="BuildingFikaReference=true;OutputPath=$(FikaReferenceDir)bin/;IntermediateOutputPath=$(FikaReferenceDir)obj/" />
    <MSBuild Projects="fika/HORIZON.Fika.csproj" Targets="Restore;Build"
             Properties="MainAssemblyPath=$(FikaReferenceDir)bin/HORIZON.dll;Configuration=$(Configuration);TransportVersion=$(Version);TransportAssemblyVersion=$(AssemblyVersion)"
             RemoveProperties="BuildingFikaReference;OutputPath;IntermediateOutputPath" />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(SptRoot)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SptRoot)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/Assembly-CSharp.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/DissonanceVoip.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/Comfort.Unity.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(SptRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
</Project>
